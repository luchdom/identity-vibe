@AuthServer_HostAddress = http://localhost:5000
@access_token = YOUR_ACCESS_TOKEN_HERE
@refresh_token = YOUR_REFRESH_TOKEN_HERE

# ===========================================
# AuthServer Health / Discovery
# ===========================================

### Health
GET {{AuthServer_HostAddress}}/health

### OpenID configuration (discovery)
GET {{AuthServer_HostAddress}}/.well-known/openid-configuration

# ===========================================
# OAuth2 / OpenID Connect Token Endpoints
# ===========================================

### Refresh Token (web-admin public client)
POST {{AuthServer_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token
&client_id=web-admin
&refresh_token={{refresh_token}}

### Client Credentials Token (orders service client)
POST {{AuthServer_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=orders
&client_secret=orders-secret
&scope=orders.read orders.write orders.manage

# Note: interactive user login for web-admin uses Authorization Code + PKCE in the browser,
# not password grant. Start from:
# GET {{AuthServer_HostAddress}}/connect/authorize?... (generated by the frontend)

# ===========================================
# User Info
# ===========================================

### UserInfo (requires user access token)
GET {{AuthServer_HostAddress}}/connect/userinfo
Authorization: Bearer {{access_token}}

### Logout (browser flow endpoint)
POST {{AuthServer_HostAddress}}/connect/logout
Authorization: Bearer {{access_token}}

# ===========================================
# Scope / Client Metadata (protected)
# ===========================================

### Get All Clients
GET {{AuthServer_HostAddress}}/scope/clients
Authorization: Bearer {{access_token}}

### Get All Scopes
GET {{AuthServer_HostAddress}}/scope/scopes
Authorization: Bearer {{access_token}}

