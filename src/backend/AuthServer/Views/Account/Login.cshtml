@model LoginRequest
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <h1>Login to your account</h1>
    <p>Enter your email below to login to your account</p>
</div>

<div asp-validation-summary="All" class="validation-summary"></div>

<form method="post">
    <div class="form-group">
        <label for="credential-select">Quick Login (Testing)</label>
        <select id="credential-select" onchange="fillCredentials()">
            <option value="">Select test credentials...</option>
            <option value="admin">Admin User (admin@example.com)</option>
            <option value="user">Regular User (user@example.com)</option>
            <option value="custom">Custom (manual entry)</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" id="email-input" type="email" autocomplete="username" placeholder="m@example.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Password">Password</label>
        <div class="password-group">
            <input name="Password" id="password-input" type="password" autocomplete="current-password" />
            <div class="forgot-password">
                <a href="#">Forgot your password?</a>
            </div>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
    {
        <input name="ReturnUrl" type="hidden" value="@Model.ReturnUrl" />
    }
    
    <button type="submit" class="btn-primary">Login</button>
</form>

<div class="auth-footer">
    <p>Don't have an account? <a href="@Url.Action("Register", "Account")">Sign up</a></p>
</div>
