{
  "Authentication": {
    "Authority": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:*", "https://localhost:*"
    ]
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-server": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
