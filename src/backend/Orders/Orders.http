@Orders_HostAddress = http://localhost:5003
@access_token = YOUR_ACCESS_TOKEN_HERE

# ===========================================
# Orders API (Direct Calls)
# ===========================================

### Health
GET {{Orders_HostAddress}}/health

### Get current user's orders
GET {{Orders_HostAddress}}/orders?page=1&pageSize=10
Authorization: Bearer {{access_token}}

### Get all orders (admin)
GET {{Orders_HostAddress}}/orders/all?page=1&pageSize=10
Authorization: Bearer {{access_token}}

### Create order
POST {{Orders_HostAddress}}/orders
Authorization: Bearer {{access_token}}
Content-Type: application/json
Idempotency-Key: order-12345-unique

{
  "customer": {
    "firstName": "John",
    "lastName": "Doe",
    "email": "customer@example.com",
    "phone": "+1234567890"
  },
  "items": [
    {
      "productSku": "LAPTOP-001",
      "productName": "Gaming Laptop",
      "productDescription": "High-performance gaming laptop",
      "quantity": 1,
      "unitPrice": 1299.99
    }
  ],
  "shipping": {
    "address": "123 Main St",
    "city": "Anytown",
    "state": "NY",
    "postalCode": "12345",
    "country": "USA"
  },
  "specialInstructions": "Please handle with care"
}

### Get order by ID
GET {{Orders_HostAddress}}/orders/1
Authorization: Bearer {{access_token}}

### Update order
PUT {{Orders_HostAddress}}/orders/1
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "specialInstructions": "Updated instructions"
}

### Cancel order
POST {{Orders_HostAddress}}/orders/1/cancel
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "reason": "Customer requested cancellation"
}

# Token tip:
# Use `src/backend/AuthServer/AuthServer.http` to obtain tokens directly from AuthServer.
