{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/orders-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithEnvironmentName", "WithMachineName", "WithProcessId", "WithThreadId", "WithCorrelationId"]
  },
  "Logging": {
    "LogDirectory": "logs"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=Orders;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Authority": "${EXTERNAL_AUTH_URL}"
  },
  "Authorization": {
    "Policies": {
      "orders.read": {
        "Scopes": ["orders.read", "orders.manage"]
      },
      "orders.write": {
        "Scopes": ["orders.write", "orders.manage"]
      },
      "orders.manage": {
        "Scopes": ["orders.manage"]
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:*", "https://localhost:*", "*", "http://localhost:3000"
    ]
  }
}
